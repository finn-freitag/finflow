# Database configuration (used by docker-compose.yml)
POSTGRES_USER=finflow
POSTGRES_PASSWORD=finflow_secret
POSTGRES_DB=finflow
DATABASE_URL=postgresql://finflow:finflow_secret@localhost:5432/finflow

# App URL & Port
APP_PORT=3000
APP_URL=http://localhost:3000

# Security
JWT_SECRET=change-this-super-secret-jwt-key-in-production-min-32-chars

# Optional First-Launch Admin Seeding
# If left blank, the app presents a Web Onboarding Wizard on first visit to create the Admin user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Authentication Mode: 'both' | 'builtin' | 'oidc'
AUTH_MODE=both
ALLOW_REGISTRATION=false

# Optional OIDC Configuration (Keycloak, Authentik, Pocket ID, Authelia, Google, Okta, etc.)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_PROVIDER_NAME="Single Sign-On (OIDC)"
