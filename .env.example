# FinFlow configuration. Copy this file to ".env" next to docker-compose.yml and adjust it.

# Image version: "latest" follows the newest build of master; set a release (e.g. 1.2.0) to pin it.
FINFLOW_VERSION=latest

# Database configuration (used by docker-compose.yml)
# Change the password before the first start; the database is created with it.
POSTGRES_USER=finflow
POSTGRES_PASSWORD=finflow_secret
POSTGRES_DB=finflow
# Only needed when running the app outside Docker (npm run dev); docker-compose.yml builds its own.
# Without it, the app uses an embedded database in ./data/pglite.
# DATABASE_URL=postgresql://finflow:finflow_secret@localhost:5432/finflow

# App URL & Port
APP_PORT=3000
APP_URL=http://localhost:3000

# Security
# Leave empty to let the app generate a random secret (stored in the database), or set a long
# random value, e.g. from: openssl rand -hex 32
JWT_SECRET=

# Timezone used to decide when recurring transactions are due
TZ=Europe/Berlin

# Optional First-Launch Admin Seeding
# If left blank, the app presents a Web Onboarding Wizard on first visit to create the Admin user.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Authentication Mode: 'both' | 'builtin' | 'oidc'
AUTH_MODE=both
ALLOW_REGISTRATION=false

# Optional OIDC Configuration (Keycloak, Authentik, Pocket ID, Authelia, Google, Okta, etc.)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
OIDC_PROVIDER_NAME="Single Sign-On (OIDC)"
